# Local development values ONLY.
# These credentials are throwaway and never leave your machine, which is why this
# file is committed — the stack works immediately after cloning. Real secrets
# (payment keys, production passwords) must NEVER be added here.

# --- Postgres ---
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale
POSTGRES_PASSWORD=flashsale
POSTGRES_PORT=5432

# --- pgAdmin (database GUI) ---
# pgAdmin validates this address and rejects reserved domains like ".local".
PGADMIN_EMAIL=admin@flashsale.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# --- Applications ---
BACKEND_PORT=8080
FRONTEND_PORT=3000
